@using ScrapManagement.Web.Infrastructure
@{
    var offers = ViewBag.Offers as List<PlanOffer> ?? new List<PlanOffer>();
    var selected = ViewBag.SelectedOffer as string;
    var cur = AppOpts.Value.CurrencySymbol;
    // first card is pre-selected when nothing was chosen before
    if (string.IsNullOrEmpty(selected) && offers.Any()) selected = offers.First().Key;
}
@if (!offers.Any())
{
    <div class="alert alert-warning mb-0">No plans are available right now.</div>
}
else
{
    <div class="row g-3 plan-offers">
    @foreach (var o in offers)
    {
        var id = $"offer_{o.PlanId}_{o.Period}";
        <div class="col-md-6">
          <input type="radio" class="btn-check" name="offer" id="@id" value="@o.Key" checked="@(o.Key == selected)" required />
          <label class="btn btn-outline-dark w-100 text-start p-3" for="@id">
            <div class="fw-semibold">@o.PlanName <span class="badge bg-secondary ms-1">@(o.Period == BillingPeriod.Monthly ? "Monthly" : "Yearly")</span></div>
            <div class="fs-4">@cur @o.Price.ToString("N0") <span class="fs-6 opacity-75">/ @(o.Period == BillingPeriod.Monthly ? "month" : "year")</span></div>
            <div class="small opacity-75">@o.MaxWorkers worker(s) + admin</div>
          </label>
        </div>
    }
    </div>
}