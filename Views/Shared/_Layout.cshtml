@{
    var isAuth = User.Identity?.IsAuthenticated == true;
    var isMain = User.IsInRole(AppRoles.MainAdmin);
    var isShopAdmin = User.IsInRole(AppRoles.ShopAdmin);
    var isShopUser = isShopAdmin || User.IsInRole(AppRoles.Worker);
    var info = Context.GetShopAccess();
    var canBuy = User.HasPermission(Permissions.ManagePurchases) && isShopUser;
    var canSeeStock = isShopUser && Context.CanViewStock();
    var canSeeBillReports = isShopUser && Context.CanViewAllBills();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @AppOpts.Value.Name</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    @AppOpts.Value.Name
                    @if (info is not null) { <small class="text-secondary d-block fs-6">@info.Shop.Name</small> }
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto">
                        @if (isMain)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="AdminShops" asp-action="Dashboard">Dashboard</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="AdminShops" asp-action="Index">Shops</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="AdminPlans" asp-action="Index">Plans &amp; prices</a></li>
                        }
                        else if (isShopUser && info?.Access is ShopAccess.Full or ShopAccess.ReadOnly)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Purchases" asp-action="Index">Purchases</a></li>
                            @if (canBuy && info?.Access == ShopAccess.Full)
                            {
                                <li class="nav-item"><a class="nav-link fw-semibold text-warning" asp-controller="Purchases" asp-action="Create">+ New purchase</a></li>
                            }
                            <li class="nav-item"><a class="nav-link" asp-controller="Products" asp-action="Index">Products</a></li>
                            @if (!isShopAdmin && User.HasPermission(Permissions.ManageCategories))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Categories" asp-action="Index">Categories</a></li>
                            }
                            @if (canSeeStock)
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Stock" asp-action="Index">Stock</a></li>
                            }
                            @if (canSeeStock || canSeeBillReports)
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Reports</a>
                                    <ul class="dropdown-menu">
                                        @if (canSeeStock)
                                        {
                                            <li><a class="dropdown-item" asp-controller="Reports" asp-action="Stock">Current stock</a></li>
                                        }
                                        @if (canSeeBillReports)
                                        {
                                            <li><a class="dropdown-item" asp-controller="Reports" asp-action="DailyPurchases">Daily purchases</a></li>
                                        }
                                    </ul>
                                </li>
                            }

                            @foreach (var m in AppModules.All)
                            {
                                if (m.Implemented && info?.Plan?.SalesModuleEnabled == true)
                                {
                                    <li class="nav-item"><a class="nav-link" asp-area="@m.Area" asp-controller="@m.Controller" asp-action="@m.Action">@m.Title</a></li>
                                }
                                else
                                {
                                    <li class="nav-item"><a class="nav-link disabled" aria-disabled="true">@m.Title <span class="badge text-bg-secondary">soon</span></a></li>
                                }
                            }
                            @if (isShopAdmin)
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Manage</a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" asp-controller="Categories" asp-action="Index">Categories</a></li>
                                        <li><a class="dropdown-item" asp-controller="Workers" asp-action="Index">Workers</a></li>
                                        <li><a class="dropdown-item" asp-controller="ShopSettings" asp-action="Index">Shop details</a></li>
                                        <li><a class="dropdown-item" asp-controller="Subscription" asp-action="Status">Subscription</a></li>
                                    </ul>
                                </li>
                            }
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (isAuth)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">@User.GetFullName()</a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword">Change password</a></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post">
                                            <button type="submit" class="dropdown-item">Log out</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Log in</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Register">Register your shop</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        @if (info is not null && info.Access == ShopAccess.ReadOnly)
        {
            <div class="alert alert-warning">Your subscription has expired. You can view stock, bills and reports, but you cannot create or change anything until it is renewed.
                <a asp-controller="Subscription" asp-action="Status" class="alert-link">Details</a></div>
        }
        else if (info is not null && info.Access == ShopAccess.Full && info.DaysLeft is <= 15)
        {
            <div class="alert alert-info">Your subscription ends in @info.DaysLeft day(s). Contact the platform admin to renew.</div>
        }
        <main role="main" class="pb-4">
            <partial name="_Alerts" />
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">&copy; @DateTime.UtcNow.Year - @AppOpts.Value.Name</div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ConfirmModal" />
    <script src="~/js/site.js" asp-append-version="true"></script>
        <script src="~/js/theme.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>