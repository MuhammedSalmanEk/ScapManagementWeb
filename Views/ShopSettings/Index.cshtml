@model Shop
@{ ViewData["Title"] = "Shop details"; }
<div class="row justify-content-center"><div class="col-lg-6"><div class="card"><div class="card-body p-4">
  <h1 class="h4 mb-3">Shop details</h1>
  <p class="text-muted">These details are printed on every purchase bill.</p>
  <form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="OwnerName" class="form-label"></label><input asp-for="OwnerName" class="form-control" /><span asp-validation-for="OwnerName" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Address" class="form-label"></label><textarea asp-for="Address" class="form-control" rows="2"></textarea></div>
    <div class="mb-3"><label asp-for="TaxNumber" class="form-label"></label><input asp-for="TaxNumber" class="form-control" /></div>
    <div class="mb-3"><label asp-for="InvoiceFooter" class="form-label"></label><input asp-for="InvoiceFooter" class="form-control" /></div>
    <h2 class="h6 mt-4">Printer</h2>
    <div class="mb-3">
      <label asp-for="ReceiptPaperWidthMm" class="form-label"></label>
      <select asp-for="ReceiptPaperWidthMm" class="form-select">
        <option value="80">Thermal 80 mm</option>
        <option value="58">Thermal 58 mm</option>
        <option value="0">A4 / normal printer</option>
      </select>
    </div>
    <div class="form-check mb-3">
      <input asp-for="AutoPrintReceipt" class="form-check-input" />
      <label asp-for="AutoPrintReceipt" class="form-check-label"></label>
    </div>
    <button class="btn btn-dark">Save</button>
  </form>
</div></div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
