@model StockDetailsViewModel
@{
    var p = Model.Product;
    ViewData["Title"] = p.Name + " - stock";
    var cur = AppOpts.Value.CurrencySymbol;
    var canOpenBills = Context.CanViewAllBills();
    TimeZoneInfo tz;
    try { tz = TimeZoneInfo.FindSystemTimeZoneById(AppOpts.Value.TimeZoneId); } catch { tz = TimeZoneInfo.Utc; }
}
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
  <div>
    <h1 class="h3 mb-0">@p.Name</h1>
    <div class="text-muted">@(p.Category?.Name ?? "No category") @if (!p.IsActive) { <span class="badge text-bg-secondary">inactive</span> }</div>
  </div>
  <a class="btn btn-outline-dark" asp-action="Index">&larr; All stock</a>
</div>

<div class="row g-3 mb-3">
  <div class="col-6 col-lg-3"><div class="card stat-card"><div class="card-body"><div class="text-muted">In stock now (kg)</div><div class="display-6">@p.StockKg.ToString("N3")</div></div></div></div>
  <div class="col-6 col-lg-3"><div class="card stat-card"><div class="card-body"><div class="text-muted">Total bought (kg)</div><div class="display-6">@Model.TotalInKg.ToString("N3")</div></div></div></div>
  <div class="col-6 col-lg-3"><div class="card stat-card"><div class="card-body"><div class="text-muted">Retail / kg</div><div class="display-6">@cur @p.DefaultRatePerKg.ToString("N2")</div></div></div></div>
  <div class="col-6 col-lg-3"><div class="card stat-card"><div class="card-body"><div class="text-muted">Wholesale / kg</div><div class="display-6">@(p.WholesaleRatePerKg > 0 ? cur + " " + p.WholesaleRatePerKg.ToString("N2") : "-")</div></div></div></div>
</div>

<div class="card"><div class="card-body">
  <h2 class="h5">Stock history <span class="text-muted fs-6">(@Model.MovementCount movement(s)@(Model.MovementCount > Model.Movements.Count ? ", latest " + Model.Movements.Count : ""))</span></h2>
  <div class="table-responsive"><table class="table table-sm align-middle table-numeric mb-0">
    <thead><tr><th>Date</th><th>Type</th><th>Bill</th><th>Seller</th><th class="num">Qty (kg)</th><th class="num">Rate / kg</th></tr></thead>
    <tbody>
    @foreach (var m in Model.Movements)
    {
        var when = TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(m.At, DateTimeKind.Utc), tz);
        <tr>
          <td>@when.ToString("dd MMM yyyy HH:mm")</td>
          <td>@(m.Type == StockMovementType.Purchase ? "Purchase (in)" : "Sale (out)")</td>
          <td>
            @if (m.BillId.HasValue && canOpenBills) { <a asp-controller="Purchases" asp-action="Details" asp-route-id="@m.BillId">@(m.InvoiceNumber ?? ("#" + m.BillId))</a> }
            else { @(m.InvoiceNumber ?? "-") }
          </td>
          <td>@m.SellerName</td>
          <td class="num @(m.QuantityKg < 0 ? "text-danger" : "text-success")">@(m.QuantityKg > 0 ? "+" : "")@m.QuantityKg.ToString("N3")</td>
          <td class="num">@(m.RatePerKg.HasValue ? m.RatePerKg.Value.ToString("N2") : "-")</td>
        </tr>
    }
    @if (!Model.Movements.Any()) { <tr><td colspan="6" class="text-muted">No stock movements yet. Stock is added when a purchase bill is finalized.</td></tr> }
    </tbody>
  </table></div>
</div></div>