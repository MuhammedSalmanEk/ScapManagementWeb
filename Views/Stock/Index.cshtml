@model StockListViewModel
@{
    ViewData["Title"] = "Stock";
    var canDownload = Context.GetShopAccess()?.Plan?.AllowReportDownloads == true;
}
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
  <h1 class="h3 mb-0">Stock</h1>
  <div class="d-flex gap-2 flex-wrap">
    <button type="button" class="btn btn-outline-dark" onclick="window.print()">Print A4</button>
    <a class="btn btn-outline-dark" target="_blank" asp-controller="Reports" asp-action="StockPrint" asp-route-paper="80">Print 80mm</a>
    <a class="btn btn-outline-dark" target="_blank" asp-controller="Reports" asp-action="StockPrint" asp-route-paper="58">Print 58mm</a>
    @if (canDownload) { <a class="btn btn-outline-dark" asp-controller="Reports" asp-action="StockCsv">Download CSV</a> }
    <a class="btn btn-outline-dark" asp-controller="Reports" asp-action="Stock">Stock report</a>
  </div>
</div>

<div class="row g-3 mb-3">
  <div class="col-6 col-lg-3"><div class="card stat-card"><div class="card-body"><div class="text-muted">Total stock (kg)</div><div class="display-6">@Model.TotalKg.ToString("N3")</div></div></div></div>
  <div class="col-6 col-lg-3"><div class="card stat-card"><div class="card-body"><div class="text-muted">Products</div><div class="display-6">@Model.Products.Count</div></div></div></div>
  <div class="col-6 col-lg-3"><div class="card stat-card"><div class="card-body"><div class="text-muted">Low (&lt; @Model.LowBelow.ToString("0.##") kg)</div><div class="display-6 @(Model.LowCount > 0 ? "text-warning" : "")">@Model.LowCount</div></div></div></div>
  <div class="col-6 col-lg-3"><div class="card stat-card"><div class="card-body"><div class="text-muted">Out of stock</div><div class="display-6 @(Model.ZeroCount > 0 ? "text-danger" : "")">@Model.ZeroCount</div></div></div></div>
</div>

<form method="get" class="row g-2 mb-3 d-print-none">
  <div class="col-12 col-md-3"><input name="search" value="@Model.Search" class="form-control" placeholder="Search products" /></div>
  <div class="col-6 col-md-2"><select name="categoryId" class="form-select" asp-items="@Model.Categories"><option value="">All categories</option></select></div>
  <div class="col-6 col-md-2">
    <select name="sort" class="form-select">
      <option value="low" selected="@(Model.Sort == "low")">Lowest first</option>
      <option value="high" selected="@(Model.Sort == "high")">Highest first</option>
      <option value="name" selected="@(Model.Sort == "name")">Name A-Z</option>
    </select>
  </div>
  <div class="col-6 col-md-2"><input name="lowBelow" type="number" step="0.1" min="0" value="@Model.LowBelow.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" class="form-control" title="Highlight stock below (kg)" /></div>
  <div class="col-6 col-md-2 d-flex align-items-center"><div class="form-check"><input class="form-check-input" type="checkbox" name="showInactive" value="true" id="inactive" checked="@Model.ShowInactive" /><label class="form-check-label" for="inactive">Inactive</label></div></div>
  <div class="col-12 col-md-1"><button class="btn btn-outline-dark w-100">Go</button></div>
</form>

<div class="card"><div class="table-responsive"><table class="table align-middle table-numeric mb-0">
  <thead><tr><th>Product</th><th>Category</th><th class="num">Stock (kg)</th><th class="d-print-none"></th></tr></thead>
  <tbody>
  @foreach (var p in Model.Products)
  {
      var cls = p.StockKg <= 0 ? "table-danger" : (p.StockKg < Model.LowBelow ? "table-warning" : "");
      <tr class="@cls">
        <td>@p.Name @if (!p.IsActive) { <span class="badge text-bg-secondary">inactive</span> }</td>
        <td>@p.Category?.Name</td>
        <td class="num fw-semibold">@p.StockKg.ToString("N3")</td>
        <td class="text-end d-print-none"><a class="btn btn-sm btn-outline-dark" asp-action="Details" asp-route-id="@p.Id">Details</a></td>
      </tr>
  }
  @if (!Model.Products.Any()) { <tr><td colspan="4" class="text-muted">No products found.</td></tr> }
  </tbody>
  <tfoot><tr class="fw-semibold"><td colspan="2">Total</td><td class="num">@Model.TotalKg.ToString("N3")</td><td class="d-print-none"></td></tr></tfoot>
</table></div></div>