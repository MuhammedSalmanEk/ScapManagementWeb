@model PurchaseBill
@{
    Layout = null;
    var shop = (Shop)ViewBag.Shop;
    var cur = AppOpts.Value.CurrencySymbol;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(Model.InvoiceNumber ?? "Draft bill")</title>
    <style>
        body { font-family: Arial, Helvetica, sans-serif; color: #111; margin: 0; padding: 24px; }
        .bill { max-width: 780px; margin: 0 auto; position: relative; }
        h1 { font-size: 22px; margin: 0; } .muted { color: #555; font-size: 13px; }
        .head { text-align: center; border-bottom: 2px solid #111; padding-bottom: 10px; margin-bottom: 14px; }
        .meta { display: flex; justify-content: space-between; gap: 16px; margin-bottom: 14px; font-size: 14px; }
        table { width: 100%; border-collapse: collapse; font-size: 14px; }
        th, td { border: 1px solid #999; padding: 6px 8px; } th { background: #eee; text-align: left; }
        td.num, th.num { text-align: right; }
        tfoot td { font-weight: bold; }
        .sign { display: flex; justify-content: space-between; margin-top: 56px; font-size: 13px; }
        .sign div { border-top: 1px solid #111; padding-top: 4px; min-width: 180px; text-align: center; }
        .foot { margin-top: 18px; text-align: center; font-size: 12px; color: #555; }
        .watermark { position: absolute; top: 40%; left: 20%; font-size: 90px; color: rgba(200,0,0,.12); transform: rotate(-20deg); pointer-events: none; }
        .toolbar { max-width: 780px; margin: 0 auto 16px; }
        .toolbar button { padding: 8px 16px; font-size: 14px; }
        @@media print { .toolbar { display: none; } body { padding: 0; } }
    </style>
</head>
<body>
<div class="toolbar"><button onclick="window.print()">Print / Save as PDF</button></div>
<div class="bill">
    @if (Model.Status == BillStatus.Draft) { <div class="watermark">DRAFT</div> }
    <div class="head">
        <h1>@shop.Name</h1>
        @if (!string.IsNullOrEmpty(shop.Address)) { <div class="muted">@shop.Address</div> }
        <div class="muted">
            @if (!string.IsNullOrEmpty(shop.Phone)) { <span>Phone: @shop.Phone</span> }
            @if (!string.IsNullOrEmpty(shop.TaxNumber)) { <span> &nbsp;|&nbsp; Tax/Licence: @shop.TaxNumber</span> }
        </div>
        <div style="margin-top:6px;font-weight:bold">PURCHASE BILL</div>
    </div>
    <div class="meta">
        <div>
            <div><strong>Seller:</strong> @Model.SellerName</div>
            @if (!string.IsNullOrEmpty(Model.SellerPhone)) { <div>Phone: @Model.SellerPhone</div> }
            @if (!string.IsNullOrEmpty(Model.SellerAddress)) { <div>@Model.SellerAddress</div> }
            @if (!string.IsNullOrEmpty(Model.SellerIdNumber)) { <div>ID: @Model.SellerIdNumber</div> }
        </div>
        <div style="text-align:right">
            <div><strong>Invoice no:</strong> @(Model.InvoiceNumber ?? "-")</div>
            <div><strong>Date:</strong> @Model.BillDate.ToString("dd MMM yyyy")</div>
        </div>
    </div>
    <table>
        <thead><tr><th>#</th><th>Product</th><th class="num">Qty (kg)</th><th class="num">Rate / kg</th><th class="num">Amount (@cur)</th></tr></thead>
        <tbody>
        @{ var n = 0; }
        @foreach (var i in Model.Items)
        {
            n++;
            <tr><td>@n</td><td>@i.ProductName</td><td class="num">@i.QuantityKg.ToString("N3")</td><td class="num">@i.RatePerKg.ToString("N2")</td><td class="num">@i.LineTotal.ToString("N2")</td></tr>
        }
        </tbody>
        <tfoot><tr><td colspan="2">Total</td><td class="num">@Model.TotalKg.ToString("N3")</td><td></td><td class="num">@cur @Model.TotalAmount.ToString("N2")</td></tr></tfoot>
    </table>
    @if (!string.IsNullOrEmpty(Model.Notes)) { <p class="muted">Note: @Model.Notes</p> }
    <div class="sign"><div>Seller signature</div><div>Authorised signature</div></div>
    @if (!string.IsNullOrEmpty(shop.InvoiceFooter)) { <div class="foot">@shop.InvoiceFooter</div> }
</div>
</body>
</html>
