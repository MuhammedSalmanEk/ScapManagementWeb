@using System.Text.Json
@model PurchaseFormPageModel
@{
    var f = Model.Form;
    var isNew = f.Id is null;
    ViewData["Title"] = isNew ? "New purchase bill" : "Edit draft bill";
    var cur = AppOpts.Value.CurrencySymbol;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var showStock = Context.CanViewStock();
    var initialItems = JsonSerializer.Serialize(f.Items.Select(i => new { i.ProductId, i.NewProductName, i.NewCategoryId, i.QuantityKg, i.RatePerKg, i.NewOtherRatePerKg }),
        new JsonSerializerOptions(JsonSerializerDefaults.Web));
}
<h1 class="h3 mb-3">@ViewData["Title"]</h1>
<form method="post" id="billForm" data-show-stock="@(showStock ? "1" : "0")" asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@(isNew ? null : f.Id)">
  <input type="hidden" asp-for="Form.Id" />
  <div asp-validation-summary="All" class="alert alert-danger" style="@(ViewData.ModelState.IsValid ? "display:none" : "")"></div>

  <div class="card mb-3"><div class="card-body">
    <h2 class="h5">Seller</h2>
    <div class="row g-3">
      <div class="col-12 col-md-4"><label asp-for="Form.SellerName" class="form-label"></label><input asp-for="Form.SellerName" class="form-control" required /></div>
      <div class="col-6 col-md-3"><label asp-for="Form.SellerPhone" class="form-label"></label><input asp-for="Form.SellerPhone" class="form-control" inputmode="tel" /></div>
      <div class="col-6 col-md-3"><label asp-for="Form.SellerIdNumber" class="form-label"></label><input asp-for="Form.SellerIdNumber" class="form-control" /></div>
      <div class="col-12 col-md-2"><label asp-for="Form.BillDate" class="form-label"></label><input asp-for="Form.BillDate" type="date" class="form-control" required /></div>
      @* <div class="col-12"><label asp-for="Form.SellerAddress" class="form-label"></label><input asp-for="Form.SellerAddress" class="form-control" /></div> *@
    </div>
  </div></div>

  <div class="card mb-3"><div class="card-body">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-1">
      <h2 class="h5 mb-0">Items</h2>
      <div class="btn-group" role="group" aria-label="Rate type">
        <input type="radio" class="btn-check" name="Form.RateType" id="rt_retail" value="Retail" checked="@(f.RateType == RateType.Retail)" />
        <label class="btn btn-outline-dark btn-sm" for="rt_retail">Retail rate</label>
        <input type="radio" class="btn-check" name="Form.RateType" id="rt_wholesale" value="Wholesale" checked="@(f.RateType == RateType.Wholesale)" />
        <label class="btn btn-outline-dark btn-sm" for="rt_wholesale">Wholesale rate</label>
      </div>
    </div>
    <div class="form-text mb-3">The rate fills in from the product's retail or wholesale price. You can still type a different rate on any line.</div>

    <div id="items"></div>

    <button type="button" class="btn btn-outline-dark" id="addRow">+ Add item</button>

    <div class="bill-total d-flex justify-content-between align-items-center mt-3 p-3 rounded">
      <div><span class="text-muted">Total</span> <strong><span id="totalKg">0.000</span> kg</strong></div>
      <div class="fs-4 fw-semibold">@cur <span id="totalAmount">0.00</span></div>
    </div>

    <div class="mt-3"><label asp-for="Form.Notes" class="form-label"></label><input asp-for="Form.Notes" class="form-control" /></div>
  </div></div>

  <div class="bill-actions d-flex gap-2 flex-wrap">
    <button type="submit" name="submitAction" value="finalize" class="btn btn-dark" id="finalizeBtn">Finalize &amp; generate bill</button>
    <button type="submit" name="submitAction" value="draft" class="btn btn-outline-dark">Save as draft</button>
    <a class="btn btn-link" asp-action="Index">Cancel</a>
  </div>
  <p class="text-muted mt-2 mb-0">Stock increases only when you finalize. A finalized bill cannot be edited.</p>
</form>

<template id="rowTemplate">
  <div class="item-row card item-card mb-2"><div class="card-body p-3">
    <div class="d-flex gap-2 align-items-end mb-2">
      <div class="flex-grow-1">
        <label class="form-label small mb-1">Product</label>
        <select name="Form.Items[__i__].ProductId" class="form-select product-select">
          <option value="">Select product…</option>
          @foreach (var p in Model.Products)
          {
              <option value="@p.Id"
                      data-rate="@p.Rate.ToString(inv)"
                      data-wholesale="@p.WholesaleRate.ToString(inv)"
                      data-stock="@(showStock ? p.StockKg.ToString("N3") : "")">@p.Name</option>
          }
          @if (Model.CanAddProducts) { <option value="0">+ New product…</option> }
        </select>
      </div>
      <button type="button" class="btn btn-outline-danger remove-row" title="Remove item" aria-label="Remove item">&times;</button>
    </div>

    <div class="new-product d-none border rounded p-2 mb-2 bg-light">
      <div class="row g-2">
        <div class="col-12 col-md-6">
          <label class="form-label small mb-1">New product name</label>
          <input name="Form.Items[__i__].NewProductName" class="form-control" placeholder="e.g. Copper wire" maxlength="100" />
        </div>
        <div class="col-12 col-md-6">
          <label class="form-label small mb-1">Category</label>
          <select name="Form.Items[__i__].NewCategoryId" class="form-select">
            <option value="">No category</option>
            @foreach (var c in Model.Categories) { <option value="@c.Id">@c.Name</option> }
          </select>
        </div>
        <div class="col-12">
          <label class="form-label small mb-1 other-rate-label">Wholesale price for this new product (optional)</label>
          <input name="Form.Items[__i__].NewOtherRatePerKg" type="number" inputmode="decimal" step="0.01" min="0" class="form-control" />
          <div class="form-text other-rate-help"></div>
        </div>
      </div>
    </div>

    <div class="row g-2 align-items-end">
      <div class="col-6 col-md-4">
        <label class="form-label small mb-1">Quantity (kg)</label>
        <input name="Form.Items[__i__].QuantityKg" type="number" inputmode="decimal" step="0.001" min="0.001" class="form-control qty" />
      </div>
      <div class="col-6 col-md-4">
        <label class="form-label small mb-1 rate-label">Rate / kg</label>
        <input name="Form.Items[__i__].RatePerKg" type="number" inputmode="decimal" step="0.01" min="0.01" class="form-control rate" />
      </div>
      <div class="col-12 col-md-4 text-md-end">
        <div class="small text-muted">Amount</div>
        <div class="fs-5 fw-semibold">@cur <span class="line-total">0.00</span></div>
      </div>
    </div>
    <div class="form-text stock-hint"></div>
  </div></div>
</template>

@section Scripts {
  <partial name="_ValidationScriptsPartial" />
  <script>window.billInitialItems = @Html.Raw(initialItems);</script>
  <script src="~/js/purchase-form.js" asp-append-version="true"></script>
}