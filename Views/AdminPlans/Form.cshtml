@model SubscriptionPlan
@{ ViewData["Title"] = Model.Id == 0 ? "New plan" : "Edit plan"; }
<div class="row justify-content-center"><div class="col-lg-6"><div class="card"><div class="card-body p-4">
  <h1 class="h4 mb-3">@ViewData["Title"]</h1>
  <form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Description" class="form-label"></label><input asp-for="Description" class="form-control" /></div>
    @* <div class="row">
      <div class="col-md-6 mb-3"><label asp-for="YearlyPrice" class="form-label"></label><input asp-for="YearlyPrice" type="number" step="0.01" min="0" class="form-control" /><span asp-validation-for="YearlyPrice" class="text-danger"></span></div>
      <div class="col-md-6 mb-3"><label asp-for="MaxWorkers" class="form-label"></label><input asp-for="MaxWorkers" type="number" min="0" max="100" class="form-control" /><span asp-validation-for="MaxWorkers" class="text-danger"></span></div>
    </div> *@
    @* <div class="row">
    <div class="col-md-4 mb-3"><label asp-for="MonthlyPrice" class="form-label"></label><input asp-for="MonthlyPrice" type="number" step="0.01" min="0" class="form-control" /><span asp-validation-for="MonthlyPrice" class="text-danger"></span></div>
    <div class="col-md-4 mb-3"><label asp-for="YearlyPrice" class="form-label"></label><input asp-for="YearlyPrice" type="number" step="0.01" min="0" class="form-control" /><span asp-validation-for="YearlyPrice" class="text-danger"></span></div>
    <div class="col-md-4 mb-3"><label asp-for="MaxWorkers" class="form-label"></label><input asp-for="MaxWorkers" type="number" min="0" max="100" class="form-control" /><span asp-validation-for="MaxWorkers" class="text-danger"></span></div>
  </div> *@
    <div class="row">
    <div class="col-md-6 mb-3">
      <div class="form-check mb-1"><input asp-for="OfferMonthly" class="form-check-input" /><label asp-for="OfferMonthly" class="form-check-label"></label></div>
      <input asp-for="MonthlyPrice" type="number" step="0.01" min="0" class="form-control" placeholder="Monthly price" />
      <span asp-validation-for="MonthlyPrice" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
      <div class="form-check mb-1"><input asp-for="OfferYearly" class="form-check-input" /><label asp-for="OfferYearly" class="form-check-label"></label></div>
      <input asp-for="YearlyPrice" type="number" step="0.01" min="0" class="form-control" placeholder="Yearly price" />
      <span asp-validation-for="YearlyPrice" class="text-danger"></span>
    </div>
  </div>
 <div class="mb-3"><label asp-for="MaxWorkers" class="form-label"></label><input asp-for="MaxWorkers" type="number" min="0" max="100" class="form-control" /><span asp-validation-for="MaxWorkers" class="text-danger"></span></div>
    <div class="form-check"><input asp-for="AllowReportDownloads" class="form-check-input" /><label asp-for="AllowReportDownloads" class="form-check-label"></label></div>
    <div class="form-check"><input asp-for="SalesModuleEnabled" class="form-check-input" /><label asp-for="SalesModuleEnabled" class="form-check-label"></label></div>
    <div class="form-check"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label"></label></div>
    <div class="mt-4"><button class="btn btn-dark">Save</button> <a class="btn btn-link" asp-action="Index">Cancel</a></div>
  </form>
</div></div></div></div>
@* @section Scripts { <partial name="_ValidationScriptsPartial" /> } *@



@section Scripts {
  <partial name="_ValidationScriptsPartial" />
  <script>
    [['OfferMonthly','MonthlyPrice'],['OfferYearly','YearlyPrice']].forEach(([c, p]) => {
      const cb = document.getElementById(c), pr = document.getElementById(p);
      const sync = () => { pr.readOnly = !cb.checked; };
      cb.addEventListener('change', sync); sync();
    });
  </script>
}