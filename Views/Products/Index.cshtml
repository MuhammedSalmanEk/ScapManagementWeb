@model List<Product>
@{
    ViewData["Title"] = "Products";
    var showStock = Context.CanViewStock();
    var full = Context.GetShopAccess()?.Access == ShopAccess.Full;
    var canEdit = User.HasPermission(Permissions.EditProducts) && full;
    var isAdmin = User.IsInRole(AppRoles.ShopAdmin) && full;
}
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
  <h1 class="h3 mb-0">Products</h1>
  @if (User.HasPermission(Permissions.AddProducts) && full)
  {
      <a class="btn btn-dark" asp-action="Create">+ Add product</a>
  }
</div>
<form method="get" class="row g-2 mb-3">
  <div class="col-12 col-md-4"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search products" /></div>
  <div class="col-12 col-md-3"><select name="categoryId" class="form-select" asp-items="@((SelectList)ViewBag.Categories)"><option value="">All categories</option></select></div>
  <div class="col-6 col-md-3 d-flex align-items-center"><div class="form-check"><input class="form-check-input" type="checkbox" name="showInactive" value="true" id="inactive" checked="@((bool)ViewBag.ShowInactive)" /><label class="form-check-label" for="inactive">Show inactive</label></div></div>
  <div class="col-6 col-md-2"><button class="btn btn-outline-dark w-100">Filter</button></div>
</form>
<div class="card"><div class="table-responsive"><table class="table align-middle table-numeric mb-0">
  <thead>
    <tr>
      <th>Name</th><th>Category</th><th class="num">Retail / kg</th><th class="num">Wholesale / kg</th>
      @if (showStock) { <th class="num">Stock (kg)</th> }
      <th></th>
    </tr>
  </thead>
  <tbody>
  @foreach (var p in Model)
  {
      <tr class="@(p.IsActive ? "" : "text-muted")">
        <td>@p.Name @if (!p.IsActive) { <span class="badge text-bg-secondary">inactive</span> }</td>
        <td>@p.Category?.Name</td>
        <td class="num">@p.DefaultRatePerKg.ToString("N2")</td>
        <td class="num">@(p.WholesaleRatePerKg > 0 ? p.WholesaleRatePerKg.ToString("N2") : "-")</td>
        @if (showStock) { <td class="num"><a asp-controller="Stock" asp-action="Details" asp-route-id="@p.Id">@p.StockKg.ToString("N3")</a></td> }
        <td class="text-end text-nowrap">
          @if (canEdit)
          {
              <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@p.Id">Edit</a>
          }
          @if (isAdmin)
          {
              <form asp-action="Toggle" asp-route-id="@p.Id" method="post" class="d-inline"><button class="btn btn-sm btn-outline-secondary">@(p.IsActive ? "Deactivate" : "Activate")</button></form>
          }
        </td>
      </tr>
  }
  @if (!Model.Any()) { <tr><td colspan="6" class="text-muted">No products found.</td></tr> }
  </tbody></table></div></div>